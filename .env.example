# Copy this file to ".env" (same folder) and fill in the values. ".env" is git-ignored; never commit it.

# Gemini API key (Google AI Studio: https://aistudio.google.com/apikey).
# Either name works; use only one.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Admin-only chat tracing (Langfuse Cloud: https://cloud.langfuse.com -> create a project ->
# Settings -> API Keys). Set BOTH keys to turn tracing on; leave unset for no tracing.
# Pick the host matching your Langfuse Cloud region (EU shown; US: https://us.cloud.langfuse.com).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# Traces are tagged with this environment; set to "production" on the deployed service so
# local experiments stay out of the production dashboards.
# LANGFUSE_ENVIRONMENT=development

# Optional overrides (defaults shown). Changing the model or dimension requires a rebuild:
#   python scripts/build_vector_db.py
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIM=3072
# EMBEDDING_BATCH_SIZE=50
# EMBEDDING_TIMEOUT_S=30
# EMBEDDING_MAX_RETRIES=4
# SCOPE_MIN_SCORE=0.45
# LOG_LEVEL=INFO
